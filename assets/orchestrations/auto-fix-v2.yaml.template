api_version: homerail.ai/v1
kind: Workflow

metadata:
  id: auto-fix-v2
  name: HomeRail Auto Fix v2
  labels:
    scenario: document-first-draft-pr-autofix
    safety: manager-broker-only

spec:
  description: |
    A document-first Auto Fix workflow. The trusted caller supplies a bounded,
    immutable worker plan; dynamic DeepSeek V4 Flash workers implement its
    isolated sub-tasks, one DeepSeek aggregator publishes a candidate through
    the GitHub broker, and a fresh-context GLM-5.2 reviewer drives at most five
    total review rounds. Every published head first passes a trusted Manager
    broker validation gate. Revisions are performed by newly generated
    DeepSeek workers. The immutable task document, worker plan, and PR binding
    are mounted below /workspace/input.

  workspace: { mode: shared }

  pattern:
    id: auto-fix-v2
    version: 2.2.0
    source: HomeRail document-first dynamic worker review loop
    parameters:
      max_plan_items: 3
      max_parallel_implementers: 3
      max_review_rounds: 5
      github_mutation: manager_broker

  contracts:
    Start:
      type: object

    TaskItem:
      type: object
      additionalProperties: false
      required: [id, title, description, files, acceptance]
      properties:
        id: { type: string, pattern: '^[a-z][a-z0-9_-]{0,63}$' }
        title: { type: string, minLength: 1, maxLength: 300 }
        description: { type: string, minLength: 1, maxLength: 6000 }
        files:
          type: array
          minItems: 1
          maxItems: 50
          items: { type: string, minLength: 1, maxLength: 1000 }
        acceptance:
          type: array
          minItems: 1
          maxItems: 30
          items: { type: string, minLength: 1, maxLength: 2000 }

    TaskPlan:
      type: object
      additionalProperties: false
      required: [version, task_document_sha256, tasks, shared]
      properties:
        version: { type: integer, const: 1 }
        task_document_sha256: { type: string, pattern: '^[0-9a-f]{64}$' }
        tasks:
          type: array
          minItems: 1
          maxItems: 3
          items:
            type: object
            additionalProperties: false
            required: [id, title, description, files, acceptance]
            properties:
              id: { type: string, pattern: '^[a-z][a-z0-9_-]{0,63}$' }
              title: { type: string, minLength: 1, maxLength: 300 }
              description: { type: string, minLength: 1, maxLength: 6000 }
              files:
                type: array
                minItems: 1
                maxItems: 50
                items: { type: string, minLength: 1, maxLength: 1000 }
              acceptance:
                type: array
                minItems: 1
                maxItems: 30
                items: { type: string, minLength: 1, maxLength: 2000 }
        shared:
          type: object
          additionalProperties: false
          required: [repository_path, task_document, task_plan, pr_context]
          properties:
            repository_path: { type: string, const: repo }
            task_document: { type: string, const: input/task.md }
            task_plan: { type: string, const: input/task-plan.json }
            pr_context: { type: string, const: input/pr-context.json }

    WorkerResult:
      type: object
      additionalProperties: false
      required: [status, task_id, workspace_path, summary, tests]
      properties:
        status: { type: string, enum: [implemented, cannot_implement] }
        task_id: { type: string, minLength: 1, maxLength: 64 }
        commit_sha: { type: string, pattern: '^(?:[0-9a-f]{40}|[0-9a-f]{64})$' }
        workspace_path: { type: string, minLength: 1, maxLength: 1000 }
        summary: { type: string, minLength: 1, maxLength: 8000 }
        tests:
          type: array
          maxItems: 30
          items: { type: string, minLength: 1, maxLength: 2000 }

    Candidate:
      type: object
      additionalProperties: false
      required: [head_sha, manifest_sha256, summary, tests]
      properties:
        head_sha: { type: string, pattern: '^(?:[0-9a-f]{40}|[0-9a-f]{64})$' }
        manifest_sha256: { type: string, pattern: '^[0-9a-f]{64}$' }
        summary: { type: string, minLength: 1, maxLength: 12000 }
        tests:
          type: array
          maxItems: 50
          items: { type: string, minLength: 1, maxLength: 2000 }

    ValidationResult:
      type: object
      additionalProperties: false
      required: [status, verdict, head_sha, manifest_sha256, summary, tests, validation, feedback, fix_tasks]
      properties:
        status: { type: string, enum: [passed, failed, timed_out] }
        verdict: { type: string, enum: [validated, changes_requested, blocked] }
        head_sha: { type: string, pattern: '^(?:[0-9a-f]{40}|[0-9a-f]{64})$' }
        manifest_sha256: { type: string, pattern: '^[0-9a-f]{64}$' }
        summary: { type: string, maxLength: 12000 }
        tests:
          type: array
          maxItems: 50
          items: { type: string, maxLength: 2000 }
        validation:
          type: object
          additionalProperties: false
          required: [workflow_dispatched, required_checks]
          properties:
            workflow_dispatched: { type: boolean }
            required_checks:
              type: array
              minItems: 1
              maxItems: 32
              items:
                type: object
                additionalProperties: false
                required: [id, name, status, conclusion, details_url, output]
                properties:
                  id: { type: integer, minimum: 0 }
                  name: { type: string, minLength: 1, maxLength: 256 }
                  status: { type: string, minLength: 1, maxLength: 64 }
                  conclusion: { oneOf: [{ type: 'null' }, { type: string, maxLength: 64 }] }
                  details_url: { type: string, maxLength: 2000 }
                  output:
                    type: object
                    additionalProperties: false
                    required: [title, summary, text]
                    properties:
                      title: { type: string, maxLength: 1000 }
                      summary: { type: string, maxLength: 8000 }
                      text: { type: string, maxLength: 8000 }
        feedback:
          type: array
          maxItems: 30
          items: { type: string, minLength: 1, maxLength: 4000 }
        fix_tasks:
          type: array
          maxItems: 1
          items:
            type: object
            additionalProperties: false
            required: [id, feedback]
            properties:
              id: { type: string, minLength: 1, maxLength: 64 }
              feedback:
                type: array
                minItems: 1
                maxItems: 30
                items: { type: string, minLength: 1, maxLength: 4000 }

    ReviewDecision:
      type: object
      additionalProperties: false
      required: [verdict, head_sha, summary, feedback, fix_tasks]
      properties:
        verdict: { type: string, enum: [approve, changes_requested] }
        head_sha: { type: string, pattern: '^(?:[0-9a-f]{40}|[0-9a-f]{64})$' }
        summary: { type: string, minLength: 1, maxLength: 12000 }
        feedback:
          type: array
          maxItems: 30
          items: { type: string, minLength: 1, maxLength: 4000 }
        fix_tasks:
          type: array
          maxItems: 1
          items:
            type: object
            additionalProperties: false
            required: [id, feedback]
            properties:
              id: { type: string, minLength: 1, maxLength: 64 }
              feedback:
                type: array
                minItems: 1
                maxItems: 30
                items: { type: string, minLength: 1, maxLength: 4000 }

    FixResult:
      type: object
      additionalProperties: false
      required: [status, previous_head_sha, summary, tests]
      properties:
        status: { type: string, enum: [fixed, cannot_fix] }
        previous_head_sha: { type: string, pattern: '^(?:[0-9a-f]{40}|[0-9a-f]{64})$' }
        head_sha: { type: string, pattern: '^(?:[0-9a-f]{40}|[0-9a-f]{64})$' }
        manifest_sha256: { type: string, pattern: '^[0-9a-f]{64}$' }
        summary: { type: string, minLength: 1, maxLength: 8000 }
        tests:
          type: array
          maxItems: 30
          items: { type: string, minLength: 1, maxLength: 2000 }
      allOf:
        - if:
            required: [status]
            properties: { status: { const: fixed } }
          then:
            required: [head_sha, manifest_sha256]
            properties:
              head_sha: {}
              manifest_sha256: {}

  artifacts:
    - name: task-plan.json
      source: { type: handoff, node: prepare_repository, port: ready }
      media_type: application/json
      contract: TaskPlan
      required: true
      publish: always
    - name: initial-candidate.json
      source: { type: handoff, node: aggregate, port: candidate }
      media_type: application/json
      contract: Candidate
      required: false
      publish: always
    - name: final-review.json
      source:
        type: handoff
        node: review_gate
        port: approved
        json_pointer: /input/values/0
      media_type: application/json
      contract: ReviewDecision
      required: false
      publish: success

  agents:
    implementer:
      description: DeepSeek V4 Flash isolated implementation worker
      system: |
        Implement only the caller-authored input.item inside
        input.workspace_path. The immutable task plan owns worker division;
        read the mounted task document for global acceptance criteria. Never
        access the PR or credentials. input.workspace_path is a real Git
        worktree even though .git is a file. Git metadata is Manager-owned and
        read-only: do not run git add, commit, checkout, reset, or another
        metadata-changing Git command. Run focused tests, leave only intended
        working-tree changes in that exact worktree, and hand off result with
        the exact workspace path; Manager validates and commits the changes.
        Never copy changes into /workspace/repo or another worker's directory.
        If dependencies are absent, use only the repository's locked,
        lockfile-preserving install command (for npm, use npm ci and never npm
        install). Do not modify dependency manifests or lockfiles unless the
        task item explicitly lists them; revert incidental changes before
        committing.

    aggregator:
      description: DeepSeek V4 Flash candidate integrator
      system: |
        Treat the dynamic worker results as proposals. Inspect every
        Manager-created commit read-only, then copy or apply its file changes
        into /workspace/repo in declared task order, resolve overlap, and run
        focused tests. Git metadata is Manager-owned and read-only: do not run
        git add, commit, cherry-pick, checkout, reset, or merge. Use
        credential_broker_call with credential_ref github-autofix and action
        pull_request_snapshot to obtain the exact current Draft PR head. Publish
        all changed files atomically through credential_broker_call with the
        same credential_ref and action commit_workspace, the exact writable
        workspace_path, and expected_head_sha; never encode file contents into
        a tool call, omit a dirty file, or make multiple commits for one
        candidate. Never use the broker name github_pr as credential_ref, git
        push, or a raw token. Then hand off candidate with one content object
        containing exactly {"head_sha":"<commit result head_sha>",
        "manifest_sha256":"<commit result manifest_sha256>",
        "summary":"<bounded implementation summary>","tests":["<test evidence>"]}.
        The handoff tool's optional top-level summary does not satisfy the
        Candidate content contract.
        Manager derives the complete dirty-file manifest from the only writable
        worktree, binds both values to the handoff, and rejects omissions,
        unrelated paths, a worker commit SHA, or a stale PR head. Refuse
        unrelated or workflow-file changes. The
        snapshot tool arguments are exactly
        {"credential_ref":"github-autofix","action":"pull_request_snapshot","input":{}}.
        The commit action input is exactly
        {"expected_head_sha":"<snapshot head_sha>","message":"<single line>",
        "workspace_path":"repo"}.

    reviewer:
      description: GLM-5.2 fresh-context reviewer
      system: |
        Review only the immutable task document and the current Draft PR state
        obtained through credential_broker_call with credential_ref
        github-autofix and actions pull_request_snapshot, read_file, and
        checks_snapshot. The exact head already passed the trusted Manager
        validation gate before this fresh dispatch. The only repository bytes you may trust are returned
        by read_file for the exact snapshot head; your filesystem contains only
        immutable task inputs and deliberately has no repository checkout.
        Read each changed source/test file needed for the decision with
        read_file input {"expected_head_sha":"<snapshot head_sha>",
        "path":"<snapshot filename>"}.
        Every dispatch is a fresh provider session: do not rely on prior chat.
        Confirm the broker snapshot head equals input.validation.head_sha.
        Never use the broker name github_pr as credential_ref.
        Approve only when all acceptance criteria are met and checks/evidence
        are sufficient. On approval return empty feedback and fix_tasks. Otherwise
        return clear feedback and exactly one fix_tasks item containing the
        whole feedback. The handoff content must be one JSON object with
        exactly these fields: {"verdict":"approve|changes_requested",
        "head_sha":"<sha>","summary":"<text>","feedback":["<text>"],
        "fix_tasks":[{"id":"round-fix",
        "feedback":["<same feedback>"]}]}.

    fixer:
      description: DeepSeek V4 Flash dynamically generated PR fixer
      system: |
        You are a newly generated fixer for one review round. Work only in
        input.workspace_path. Use credential_broker_call with credential_ref
        github-autofix and action pull_request_snapshot to bind the latest Draft
        PR head, apply all feedback in input.item, run focused tests, and
        publish all dirty files atomically through credential_broker_call with
        the same credential_ref and action commit_workspace,
        input.workspace_path, and the snapshot head as expected_head_sha. Never
        encode file contents into a tool call or omit a dirty file. Never use
        the broker name github_pr as
        credential_ref, git push, or modify any path below .github. Hand off
        fixed with one content object containing exactly
        {"status":"fixed","previous_head_sha":"<snapshot head_sha>",
        "head_sha":"<commit result head_sha>",
        "manifest_sha256":"<commit result manifest_sha256>",
        "summary":"<bounded fix summary>","tests":["<test evidence>"]}.
        If no safe change can be published within the immutable PR path
        allowlist, leave the worktree clean, do not call commit_workspace, and
        hand off exactly {"status":"cannot_fix",
        "previous_head_sha":"<snapshot head_sha>",
        "summary":"<bounded blocker summary>","tests":["<test evidence>"]}.
        The snapshot tool
        arguments are exactly {"credential_ref":"github-autofix",
        "action":"pull_request_snapshot","input":{}}.

  nodes:
    prepare_repository:
      kind: command
      inputs: { start: { contract: Start } }
      outputs: { ready: { contract: TaskPlan }, failed: {} }
      config:
        command:
          - node
          - -e
          - >-
            const fs=require('fs'),cp=require('child_process'),crypto=require('crypto');
            const ctx=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));
            const fail=m=>{throw new Error(m)};
            if(ctx.version!==1||ctx.clone_url!==`https://github.com/${ctx.owner}/${ctx.repo}.git`)fail('clone_url does not match repository');
            if(!ctx.base_ref||!ctx.head_ref)fail('missing branch binding');
            const task=fs.readFileSync(process.argv[2]),plan=JSON.parse(fs.readFileSync(process.argv[3],'utf8'));
            const taskDigest=crypto.createHash('sha256').update(task).digest('hex');
            if(taskDigest!==ctx.task_document_sha256)fail('task document digest mismatch');
            if(plan.version!==1||plan.task_document_sha256!==taskDigest)fail('task plan identity mismatch');
            const shared=plan&&plan.shared;
            if(!shared||shared.repository_path!=='repo'||shared.task_document!=='input/task.md'||shared.task_plan!=='input/task-plan.json'||shared.pr_context!=='input/pr-context.json')fail('task plan shared paths mismatch');
            if(!/^[0-9a-f]{40}(?:[0-9a-f]{24})?$/.test(ctx.initial_head_sha||''))fail('invalid head');
            const run=a=>{const r=cp.spawnSync('git',a,{encoding:'utf8',timeout:120000,stdio:['ignore','pipe','pipe']});if(r.status!==0)fail(String(r.stderr||r.error));return String(r.stdout).trim()};
            if(!fs.existsSync('repo/.git'))run(['clone','--no-checkout','--',ctx.clone_url,'repo']);
            run(['-C','repo','fetch','--no-tags','origin',ctx.initial_head_sha]);
            run(['-C','repo','checkout','--detach',ctx.initial_head_sha]);
            const head=run(['-C','repo','rev-parse','HEAD']).toLowerCase();
            if(head!==ctx.initial_head_sha.toLowerCase())fail('checkout head mismatch');
            process.stdout.write(JSON.stringify(plan));
          - $run_input/pr_context
          - $run_input/task_document
          - $run_input/task_plan
        cwd: $run_workspace
        timeout_ms: 180000
        parse_stdout: json
        result_payload: value
        success_port: ready
        failure_port: failed

    implement:
      kind: fanout
      inputs: { plan: { contract: TaskPlan } }
      outputs: { implemented: {}, failed: {} }
      config:
        input: plan
        item_field: tasks
        context_field: shared
        worker_agent: implementer
        worker_policy:
          session_scope: dispatch
          builtin_tool_policy: backend_native
          codex_sandbox: danger-full-access
          allowed_dag_tools: [handoff]
          workspace_access: { writable_paths: ["{{fanout_workspace}}"], readonly_paths: [input] }
        workspace_strategy: isolated_git_worktree
        workspace_root: workers
        repository_path: repo
        result_git_commit:
          commit_field: commit_sha
          workspace_field: workspace_path
          require_clean: true
          commit_mode: manager
        max_items: 3
        max_parallelism: 3
        completion: all
        result_contract: WorkerResult
        success_field: status
        success_values: [implemented]
        result_port: implemented
        failed_port: failed

    aggregate:
      kind: agent
      agent: aggregator
      session_scope: dispatch
      workspace_access: { writable_paths: [repo], readonly_paths: [input, workers] }
      builtin_tool_policy: backend_native
      codex_sandbox: danger-full-access
      allowed_dag_tools: [handoff, credential_broker_call]
      credentials:
        - credential_ref: github-autofix
          purpose: integrate the candidate into the bound Draft PR
          inject:
            mode: manager_broker
            broker: github_pr
            allowed_actions: [pull_request_snapshot, commit_workspace]
      inputs: { workers: {} }
      outputs:
        candidate:
          contract: Candidate
          required_broker_actions:
            - credential_ref: github-autofix
              broker: github_pr
              action: pull_request_snapshot
            - credential_ref: github-autofix
              broker: github_pr
              action: commit_workspace
              result_binding: { result_field: head_sha, content_field: head_sha }
            - credential_ref: github-autofix
              broker: github_pr
              action: commit_workspace
              result_binding: { result_field: manifest_sha256, content_field: manifest_sha256 }
        failed: {}

    validate_initial:
      kind: broker
      inputs: { candidate: { contract: Candidate } }
      outputs: { result: { contract: ValidationResult }, error: {} }
      config:
        input: candidate
        input_map:
          expected_head_sha: head_sha
          manifest_sha256: manifest_sha256
          summary: summary
          tests: tests
        credential_ref: github-autofix
        purpose: trigger and wait for trusted validation on the initial exact Draft PR head
        broker: github_pr
        action: validate_head
        result_port: result
        error_port: error

    validation_initial_gate:
      kind: condition
      inputs: { validation: { contract: ValidationResult } }
      outputs:
        passed: { contract: ValidationResult }
        changes: { contract: ValidationResult }
        blocked: { contract: ValidationResult }
      config:
        field: status
        routes: { passed: passed, failed: changes }
        default: blocked

    initial_decision_join:
      kind: join
      inputs: { validation: {}, review: {} }
      outputs: { ready: {}, missing: {} }
      config:
        mode: any
        field: verdict
        success_values: [approve, changes_requested]
        passed_port: ready
        failed_port: missing

    review_initial:
      kind: agent
      agent: reviewer
      session_scope: dispatch
      workspace_access: { writable_paths: [], readonly_paths: [input] }
      allowed_builtin_tools: [Glob, Grep, LS, Read]
      allowed_dag_tools: [handoff, credential_broker_call]
      credentials:
        - credential_ref: github-autofix
          purpose: review the bound Draft PR without mutation
          inject:
            mode: manager_broker
            broker: github_pr
            allowed_actions: [pull_request_snapshot, read_file, checks_snapshot]
      inputs: { validation: { contract: ValidationResult } }
      outputs:
        reviewed:
          contract: ReviewDecision
          required_broker_actions:
            - credential_ref: github-autofix
              broker: github_pr
              action: pull_request_snapshot
              result_binding: { result_field: head_sha, content_field: head_sha }
            - credential_ref: github-autofix
              broker: github_pr
              action: checks_snapshot
              result_binding: { result_field: head_sha, content_field: head_sha }
        failed: {}

    review_gate:
      kind: while
      inputs: { state: {} }
      outputs: { fix: {}, approved: {}, exhausted: {} }
      config:
        field: values.0.verdict
        operator: eq
        value: approve
        continue_port: fix
        done_port: approved
        exhausted_port: exhausted
        max_iterations: 4

    fix:
      kind: fanout
      inputs: { review: {} }
      outputs: { fixed: {}, failed: {} }
      config:
        input: review
        item_field: input.values.0.fix_tasks
        context_field: input.values.0
        worker_agent: fixer
        worker_policy:
          session_scope: dispatch
          builtin_tool_policy: backend_native
          codex_sandbox: danger-full-access
          allowed_dag_tools: [handoff, credential_broker_call]
          workspace_access: { writable_paths: ["{{fanout_workspace}}"], readonly_paths: [input] }
          credentials:
            - credential_ref: github-autofix
              purpose: apply one bounded review revision to the Draft PR
              inject:
                mode: manager_broker
                broker: github_pr
                allowed_actions: [pull_request_snapshot, commit_workspace]
        workspace_strategy: isolated_git_worktree
        workspace_root: fixers
        repository_path: repo
        revision_field: head_sha
        max_items: 1
        max_parallelism: 1
        completion: all
        result_contract: FixResult
        result_required_broker_actions:
          - credential_ref: github-autofix
            broker: github_pr
            action: pull_request_snapshot
            result_binding: { result_field: head_sha, content_field: previous_head_sha }
          - credential_ref: github-autofix
            broker: github_pr
            action: commit_workspace
            when: { field: status, equals: fixed }
            result_binding: { result_field: head_sha, content_field: head_sha }
          - credential_ref: github-autofix
            broker: github_pr
            action: commit_workspace
            when: { field: status, equals: fixed }
            result_binding: { result_field: manifest_sha256, content_field: manifest_sha256 }
        success_field: status
        success_values: [fixed]
        result_port: fixed
        failed_port: failed

    validate_revision:
      kind: broker
      inputs: { fixes: {} }
      outputs: { result: { contract: ValidationResult }, error: {} }
      config:
        input: fixes
        input_map:
          expected_head_sha: results.0.content.head_sha
          manifest_sha256: results.0.content.manifest_sha256
          summary: results.0.content.summary
          tests: results.0.content.tests
        credential_ref: github-autofix
        purpose: trigger and wait for trusted validation on the revised exact Draft PR head
        broker: github_pr
        action: validate_head
        result_port: result
        error_port: error

    validation_revision_gate:
      kind: condition
      inputs: { validation: { contract: ValidationResult } }
      outputs:
        passed: { contract: ValidationResult }
        changes: { contract: ValidationResult }
        blocked: { contract: ValidationResult }
      config:
        field: status
        routes: { passed: passed, failed: changes }
        default: blocked

    revision_decision_join:
      kind: join
      inputs: { validation: {}, review: {} }
      outputs: { ready: {}, missing: {} }
      config:
        mode: any
        field: verdict
        success_values: [approve, changes_requested]
        passed_port: ready
        failed_port: missing

    review_revision:
      kind: agent
      agent: reviewer
      depends_on: [review_gate]
      session_scope: dispatch
      workspace_access: { writable_paths: [], readonly_paths: [input] }
      allowed_builtin_tools: [Glob, Grep, LS, Read]
      allowed_dag_tools: [handoff, credential_broker_call]
      credentials:
        - credential_ref: github-autofix
          purpose: re-review the bound Draft PR without mutation
          inject:
            mode: manager_broker
            broker: github_pr
            allowed_actions: [pull_request_snapshot, read_file, checks_snapshot]
      inputs: { validation: { contract: ValidationResult } }
      outputs:
        reviewed:
          contract: ReviewDecision
          required_broker_actions:
            - credential_ref: github-autofix
              broker: github_pr
              action: pull_request_snapshot
              result_binding: { result_field: head_sha, content_field: head_sha }
            - credential_ref: github-autofix
              broker: github_pr
              action: checks_snapshot
              result_binding: { result_field: head_sha, content_field: head_sha }
        failed: {}

    finalize:
      kind: broker
      inputs: { review: {} }
      outputs: { result: {}, error: {} }
      config:
        input: review
        input_map:
          expected_head_sha: input.values.0.head_sha
        credential_ref: github-autofix
        purpose: enforce final required checks on the exact approved Draft PR head
        broker: github_pr
        action: required_checks
        result_port: result
        error_port: error

    done: { kind: terminal, outcome: success, inputs: { result: {} } }
    preparation_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    implementation_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    aggregation_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    initial_review_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    revision_review_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    fix_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    initial_validation_error: { kind: terminal, outcome: failure, inputs: { result: {} } }
    initial_validation_blocked: { kind: terminal, outcome: failure, inputs: { result: {} } }
    initial_decision_missing: { kind: terminal, outcome: failure, inputs: { result: {} } }
    revision_validation_error: { kind: terminal, outcome: failure, inputs: { result: {} } }
    revision_validation_blocked: { kind: terminal, outcome: failure, inputs: { result: {} } }
    revision_decision_missing: { kind: terminal, outcome: failure, inputs: { result: {} } }
    finalization_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    needs_human: { kind: terminal, outcome: cancelled, inputs: { result: {} } }

  edges:
    - { from: $run.input, to: prepare_repository.start }
    - { from: prepare_repository.ready, to: implement.plan }
    - { from: prepare_repository.failed, to: preparation_failed.result, condition: on_failure }
    - { from: implement.implemented, to: aggregate.workers }
    - { from: implement.failed, to: implementation_failed.result, condition: on_failure }
    - { from: aggregate.candidate, to: validate_initial.candidate }
    - { from: aggregate.failed, to: aggregation_failed.result, condition: on_failure }
    - { from: validate_initial.result, to: validation_initial_gate.validation }
    - { from: validate_initial.error, to: initial_validation_error.result, condition: on_failure }
    - { from: validation_initial_gate.passed, to: review_initial.validation }
    - { from: validation_initial_gate.changes, to: initial_decision_join.validation }
    - { from: validation_initial_gate.blocked, to: initial_validation_blocked.result }
    - { from: review_initial.reviewed, to: initial_decision_join.review }
    - { from: review_initial.failed, to: initial_review_failed.result, condition: on_failure }
    - { from: initial_decision_join.ready, to: review_gate.state }
    - { from: initial_decision_join.missing, to: initial_decision_missing.result }
    - { from: review_gate.fix, to: fix.review }
    - { from: review_gate.approved, to: finalize.review }
    - { from: review_gate.exhausted, to: needs_human.result }
    - { from: fix.fixed, to: validate_revision.fixes }
    - { from: fix.failed, to: fix_failed.result, condition: on_failure }
    - { from: validate_revision.result, to: validation_revision_gate.validation }
    - { from: validate_revision.error, to: revision_validation_error.result, condition: on_failure }
    - { from: validation_revision_gate.passed, to: review_revision.validation }
    - { from: validation_revision_gate.changes, to: revision_decision_join.validation }
    - { from: validation_revision_gate.blocked, to: revision_validation_blocked.result }
    - { from: review_revision.reviewed, to: revision_decision_join.review }
    - { from: revision_decision_join.missing, to: revision_decision_missing.result }
    - kind: feedback
      from: revision_decision_join.ready
      to: review_gate.state
      max_traversals: 4
    - { from: review_revision.failed, to: revision_review_failed.result, condition: on_failure }
    - { from: finalize.result, to: done.result }
    - { from: finalize.error, to: finalization_failed.result, condition: on_failure }

  policies:
    max_nodes: 40
    max_edges: 32
    max_parallelism: 4
    max_dispatches: 32
    max_handoffs: 48
    max_corrections_per_node: 2
    max_edge_traversals: 4
